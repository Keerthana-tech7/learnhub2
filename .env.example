# Neon PostgreSQL Database Connection (Required)
# All study resources and contributed PDFs (up to 4MB) are stored directly inside PostgreSQL BYTEA columns.
# No external file storage (Cloudinary, Firebase, Supabase, S3) is required.
DATABASE_URL=postgresql://user:password@endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Administrator recipient for registration alerts & contribution notifications
ADMIN_EMAIL=admin.studyportal@gmail.com

# Session secret for session encryption and JWT tokens
SESSION_SECRET=studyportal-secret-key-2026-secure

# (Optional) SMTP Configuration for Live External Email Delivery:
# If omitted, alerts are logged to server console & database notifications table.
# SMTP_USER=admin.studyportal@gmail.com
# SMTP_PASS=your_16_char_gmail_app_password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
