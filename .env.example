# Neon PostgreSQL Database Connection
DATABASE_URL=postgresql://user:password@endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Administrator recipient for registration alerts & contribution notifications
ADMIN_EMAIL=admin.studyportal@gmail.com

# ====================================================================
# Cloudinary Cloud File Storage (Required for Vercel & Production)
# ====================================================================
# Vercel serverless containers have a read-only filesystem (/var/task).
# All uploaded PDFs are permanently hosted on Cloudinary and delivered via global CDN.
# Configure these variables in your local .env AND in your Vercel Project Settings (Project -> Settings -> Environment Variables):
#
# Option A (Individual Credentials - Recommended):
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
#
# Option B (Unified URL from Cloudinary Dashboard):
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# (Optional) SMTP Configuration for Live External Email Delivery:
# If omitted, alerts are logged to server console & database notifications table.
# SMTP_USER=admin.studyportal@gmail.com
# SMTP_PASS=your_16_char_gmail_app_password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
